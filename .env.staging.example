# ============================================================================
# ComSpace — Staging Environment Variables
# ============================================================================
# Copy to .env.staging and fill in values before running docker-compose.staging.yml
# NEVER commit this file with real secrets to version control.
# ============================================================================

# ── MongoDB ──────────────────────────────────────────────────────────────────
MONGO_USER=admin
MONGO_PASSWORD=change_me_staging_mongo_password
MONGO_DB=comspace_staging

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=change_me_staging_redis_password

# ── JWT (generate with: openssl rand -base64 64) ─────────────────────────────
JWT_SECRET=change_me_staging_jwt_secret_min_64_characters_long_xxxxxxxxxxxxx
JWT_EXPIRE=15m
JWT_REFRESH_SECRET=change_me_staging_refresh_secret_min_64_chars_xxxxxxxxxxxxxxxxxx
JWT_REFRESH_EXPIRE=30d

# ── Stripe (TEST keys for staging) ──────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_your_stripe_test_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_test_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_signing_secret

# ── Email ────────────────────────────────────────────────────────────────────
EMAIL_FROM=noreply@staging.comspace.app
SENDGRID_API_KEY=
# Or SMTP:
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# ── URLs & CORS ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:6060/api
FRONTEND_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000,http://localhost:6060

# ── Admin Seed Account ───────────────────────────────────────────────────────
ADMIN_EMAIL=admin@staging.comspace.app
ADMIN_PASSWORD=StagingAdmin@2026!

# ── Optional Services ────────────────────────────────────────────────────────
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
SENTRY_DSN=
CURRENCY_API_KEY=
GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_TENANT_ID=default
NEXT_PUBLIC_APP_NAME=ComSpace Staging
